{
  "name": "dealeros-marketplace-desktop",
  "productName": "DealerOS Marketplace",
  "version": "1.0.18",
  "description": "DealerOS Marketplace: posts each dealer's inventory to Facebook Marketplace from every rep's own logged-in profile.",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock-run": "node scripts/mock-run.js",
    "test": "node --test ./test/*.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never --config electron-builder.config.js",
    "release:win": "electron-builder --win nsis --x64 --publish always --config electron-builder.config.js",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "playwright-core": "1.48"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "ai.dealeros.marketplace",
    "productName": "DealerOS Marketplace",
    "copyright": "© 2026 DealerOS AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "mock/**",
      "build/*.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DealerOS-Marketplace-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DealerOS Marketplace",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "souzatrailers-ui",
        "repo": "dealeros-marketplace-desktop",
        "private": false,
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "DealerOS-Marketplace-${version}-mac-${arch}.${ext}"
    }
  },
  "author": {
    "name": "DealerOS AI",
    "email": "support@dealerosai.ai"
  },
  "homepage": "https://app.dealerosai.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/souzatrailers-ui/dealeros-marketplace-desktop.git"
  }
}